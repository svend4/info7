# info7 .gitignore

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Dependencies
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
out/
.next/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# API Keys and Secrets
*.key
*.pem
.secrets/
secrets.json

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pids
*.pid
*.seed
*.pid.lock

# Coverage and Testing
coverage/
.nyc_output/
*.lcov
.jest/
test-results/
playwright-report/

# Temporary files
tmp/
temp/
*.tmp
.cache/

# TypeScript
*.tsbuildinfo
.tsbuildinfo

# Python (if any scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv

# Jupyter Notebooks (if any)
.ipynb_checkpoints
*.ipynb

# Database
*.db
*.sqlite
*.sqlite3

# Documentation builds (if generated)
docs/_build/
site/

# Archives
*.zip
*.tar.gz
*.rar

# Backup files
*.bak
*.backup
*~

# Local configuration (keep examples)
config.local.*
!config.example.*

# Generated files
generated/
auto-generated/

# Miscellaneous
.todo
.notes
scratch/
