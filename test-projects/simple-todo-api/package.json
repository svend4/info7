{
  "name": "simple-todo-api",
  "version": "1.0.0",
  "description": "Simple Todo API for testing Orchestrator Kit",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
